+MANIFEST_ONLY_MESSAGE = "Custom nodes are managed by custom-nodes.yaml. Update the manifest and rebuild the container."
+MANIFEST_ONLY_ROUTES = frozenset({
+    "/customnode/install/git_url",
+    "/customnode/install/pip",
+    "/manager/queue/disable",
+    "/manager/queue/fix",
+    "/manager/queue/install",
+    "/manager/queue/reinstall",
+    "/manager/queue/uninstall",
+    "/manager/queue/update",
+    "/manager/queue/update_all",
+})
+
+
+@web.middleware
+async def manifest_only_middleware(request, handler):
+    if request.method == "POST" and request.path in MANIFEST_ONLY_ROUTES:
+        return web.Response(status=409, text=MANIFEST_ONLY_MESSAGE)
+    return await handler(request)
+
+
+PromptServer.instance.app.middlewares.append(manifest_only_middleware)
+
